# Confirmed final production HTTPS origin. Vercel Preview uses VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=https://ullanlinnansahko.fi

# Search indexing is fail-closed. Keep false for all previews and until the final domain, form E2E,
# release QA and written approval are complete. Set true only as the final release action.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Pricing is rendered only when explicitly enabled and Hanna's exact approved display string is present.
NEXT_PUBLIC_ENABLE_PRICING=false
ELECTRICIAN_HOURLY_RATE_DISPLAY=

# Contact-form attachments stay disabled until the production handling decision is approved.
NEXT_PUBLIC_ENABLE_CONTACT_ATTACHMENTS=false

# Resend is the preferred production transport. All values are server-only.
# Domain `ullanlinnansahko.fi` was added to Resend on 2026-09-09 and must be DNS-verified before a domain-restricted API key is created.
RESEND_API_KEY=
CONTACT_FORM_FROM=
CONTACT_FORM_RECIPIENT=

# Optional legacy HTTPS transport. Used only when Resend is not configured.
CONTACT_FORM_WEBHOOK_URL=

# Preview only. Never enable in the production environment.
CONTACT_FORM_DEMO_MODE=false

# Optional GA4. No analytics script is loaded unless both the feature flag and a valid measurement ID are set.
# When enabled, the site asks for analytics consent before loading GA4.
NEXT_PUBLIC_ENABLE_GA4=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Publish only after FAQ content and legal content are approved.
NEXT_PUBLIC_ENABLE_FAQ_PAGE=false
NEXT_PUBLIC_LEGAL_CONTENT_APPROVED=false
